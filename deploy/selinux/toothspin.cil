; SELinux type for the ToothSpin container (toothspin.process): a standard
; container built from udica's templates, which container-selinux ships, plus
; access to bluetoothd over the host's system D-Bus, which container_t lacks.
;
;   sudo semodule -i toothspin.cil /usr/share/udica/templates/{base_container,net_container}.cil
;   podman run --security-opt label=type:toothspin.process ...

(block toothspin
    (blockinherit container)
    ; Host network: the web UI, mDNS and the websockets to Music Assistant.
    (blockinherit net_container)

    ; PipeWire passes audio buffers between its processes as memfds.
    (allow process tmpfs_t (file (map)))

    ; The system bus socket, bind-mounted from the host...
    (allow process system_dbusd_var_run_t (sock_file (getattr write)))
    (allow process system_dbusd_t (unix_stream_socket (connectto)))
    ; ...and messages to and from the bus itself and bluetoothd only.
    (allow process system_dbusd_t (dbus (send_msg)))
    (allow system_dbusd_t process (dbus (send_msg)))
    (allow process bluetooth_t (dbus (send_msg)))
    (allow bluetooth_t process (dbus (send_msg)))
)
