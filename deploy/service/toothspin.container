# Rootless Quadlet unit for the `core` user:
# ~/.config/containers/systemd/toothspin.container
[Unit]
Description=ToothSpin, Bluetooth audio input for Music Assistant

[Quadlet]
# Quadlet would otherwise wait for the system network-online.target, which
# nothing activates on CoreOS, so (re)starts hang. The service retries its
# server connection on its own anyway.
DefaultDependencies=false

[Container]
Image=ghcr.io/eknoes/toothspin:latest
# podman-auto-update.timer pulls new releases and restarts the service.
AutoUpdate=registry
ContainerName=toothspin
# Host network: mDNS discovery of Music Assistant and the web UI on :8080.
Network=host
# Run as core's own uid inside the container: D-Bus EXTERNAL auth compares
# the uid the client claims with the socket's peer credentials.
UserNS=keep-id
# Talk to bluetoothd on the host bus; the image brings its own PipeWire.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
# A container type that may also use the system bus (deploy/selinux).
SecurityLabelType=toothspin.process
# Needs no capabilities: it only talks D-Bus and opens unprivileged ports.
DropCapability=all
NoNewPrivileges=true
Volume=toothspin-data:/data
# Optional overrides (MA_TOKEN, SENDSPIN_URL, BT_NAME, ...).
EnvironmentFile=%h/.config/toothspin.env

[Service]
# Until BlueZ and the SELinux policy are in place on first boot, starting
# fails; keep retrying.
Restart=always
RestartSec=5
# The first start pulls the image.
TimeoutStartSec=900

[Install]
WantedBy=default.target
