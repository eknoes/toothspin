# Rootless Quadlet unit for the `core` user:
# ~/.config/containers/systemd/sendspin-bluetooth.container
[Unit]
Description=Sendspin Bluetooth source
Requires=pipewire.socket
After=pipewire.socket wireplumber.service

[Quadlet]
# Quadlet would otherwise wait for the system network-online.target, which
# nothing activates on CoreOS, so (re)starts hang. The service retries its
# server connection on its own anyway.
DefaultDependencies=false

[Container]
Image=localhost/sendspin-bluetooth:latest
ContainerName=sendspin-bluetooth
# Host network: mDNS discovery of Music Assistant and the web UI on :8080.
Network=host
# Run as core's own uid inside the container: D-Bus EXTERNAL auth compares
# the uid the client claims with the socket's peer credentials.
UserNS=keep-id
# Talk to bluetoothd on the host bus and read audio from core's PipeWire.
# SELinux would otherwise deny container_t access to both sockets.
Volume=/run/dbus/system_bus_socket:/run/dbus/system_bus_socket
Volume=%t/pipewire-0:/run/pipewire/pipewire-0
SecurityLabelDisable=true
Volume=sendspin-bluetooth-data:/data
# Optional overrides (SENDSPIN_URL, SENDSPIN_NAME, BT_NAME, ...).
EnvironmentFile=%h/.config/sendspin-bluetooth.env

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
